# Express Server Configuration
PORT=5001
NODE_ENV=development
API_PREFIX=/api/v1

# Security & CORS
CORS_ORIGIN=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/mega_tools

# Request Limits
BODY_LIMIT=10mb

# Session Configuration
SESSION_TTL_HOURS=24
SESSION_REMEMBER_ME_DAYS=7

# Email Service Configuration (Optional in local development)
EMAIL_PROVIDER=console
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@megatools.io
