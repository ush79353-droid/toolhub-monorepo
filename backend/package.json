{
  "name": "omega-calculators-backend",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "categories:seed": "tsx src/scripts/seed-categories.ts",
    "tools:seed": "tsx src/scripts/seed-tools.ts",
    "tool:assign": "tsx src/scripts/assign-tool-component.ts",
    "tools:embed-defaults": "tsx src/scripts/enable-default-embeds.ts",
    "tools:publish": "tsx src/scripts/publish-browser-tools.ts",
    "categories:icons": "tsx src/scripts/attach-category-icons.ts",
    "categories:descriptions": "tsx src/scripts/set-category-descriptions.ts",
    "format": "prettier --write \"src/**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json,md}\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "argon2": "^0.45.2",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "mongoose": "^8.10.1",
    "nodemailer": "^10.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "prettier": "^3.5.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
