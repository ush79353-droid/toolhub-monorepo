# Next.js Environment Configuration
NODE_ENV=development
PORT=3000

# Public site origin used for canonical URLs, Open Graph, and JSON-LD.
# Use the real production https origin in deployed environments.
# Never point this at the Express API.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional server-only alias (falls back to NEXT_PUBLIC_SITE_URL):
# SITE_URL=https://example.com

# Server-Only Backend API URL
# CRITICAL: This must NEVER be exposed as NEXT_PUBLIC_*.
# Client-side components must communicate via Server Actions or Route Handlers.
API_INTERNAL_URL=http://localhost:5001/api/v1
API_TIMEOUT_MS=10000

# Admin Session Cookie Configuration
ADMIN_SESSION_COOKIE_NAME=admin_session
COOKIE_SECURE=false
