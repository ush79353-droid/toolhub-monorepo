# ==============================================================================
# Mega Tools - Root Environment Variables Example
# Copy to individual app .env files or load for container orchestration.
# ==============================================================================

# Node Environment
NODE_ENV=development

# Web App Configuration
WEB_PORT=3000

# Express API Configuration
API_PORT=5001
API_INTERNAL_URL=http://localhost:5001/api/v1
CORS_ORIGIN=http://localhost:3000

# MongoDB Database Configuration
MONGODB_URI=mongodb://localhost:27017/mega_tools
